<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" type="text/css" href="/utils/style.css">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
	<script type="text/javascript" src="https://cdn.socket.io/socket.io-3.0.1.min.js"></script>
	<title>Game Search Word</title>
</head>
<body>
	<div class='main'>
		<div class="setting-page" >
			<div class="page-body">
				<p class="close-setting-button close-button">
					<i class="fa fa-times"></i></p>
				<p class="title-menu">PENGATURAN</p>
				<div class="setting-item ">
					<span>Tema Malam</span>
					<span style="display:inline-block;" class="form-check form-switch">
							<input class="form-check-input night-mode" type="checkbox">
					</span>
				</div>
				<div class="setting-item">
					<span>Waktu</span> 
					<span style="display:inline-block;" class="form-check form-switch">
							<input class="form-check-input timer" type="checkbox" checked>
					</span>
				</div>
				<div class="setting-item">
					<span>Mode Sulit</span>
					<span style="display:inline-block;" class="form-check form-switch">
							<input class="form-check-input hard-mode" type="checkbox">
					</span>
				</div>
				<div class="setting-item">
					<span>Saran</span>
					<span style="display:inline-block;margin-right: 0.5rem;color: grey;text-decoration: underline;">
						<a style="color: grey;" href="mailto:edikurniadidev@gmail.com" target="_blank">Email</a>
					</span>
				</div>
			</div>
		</div>
		<div class="navbar">
			<span class="icon">
				<i class="fa fa-bars" aria-hidden="true"></i>
				<i class="fa fa-info-circle" aria-hidden="true"></i>
			</span>
			<span id="title-game"><img id='logo' src="logo1.png"></span>
			<span class="icon">
				<i class="fa fa-bar-chart" aria-hidden="true"></i>
				<i class="fa fa-cog" aria-hidden="true"></i>			
			</span>
		</div>

		<div id='container-words'>
			<p id='clock'><span id="minute">--</span>:<span id="second">--</span></p>
			<div class="word">
				<span class="box-letter">?</span>
				<span class="box-letter">?</span>
				<span class="box-letter">?</span>
				<span class="box-letter">?</span>
				<span class="box-letter">?</span>
			</div>
		</div>

		<form>
			<label id="answer" style="display:none;"></label>
			<div id="meaning"></div>
			<input id='guest' type="text" name="guest" placeholder="ayo tebak!" autocomplete="off" autofocus>
			<!-- <button id="enter-button">Jawab</button> -->
		</form>

		<button id="enter-button" onclick='sendAnswer()'>Jawab</button>
		<h1 id='tes'>asal asal</h1>
		<input type="text" id='input-username'>
		<button id="update-user-name" onclick='updateUserName()'>Update</button>
		<h2 id='username'>makan</h2>

	</div>

	<script type="text/javascript">
		
		const socket = io('http://localhost:3001');
		socket.on('connection');

		const username = document.getElementById('username').innerText;
		if(username) {
			socket.emit('join', username)
		}

		const sendAnswer = (e) => {
			// e.preventDefault();
			socket.emit('transfer', 'it work');
		};

		socket.on('transfer', (data) => {
			document.getElementById('tes').innerHTML = data;
		});


		const updateUserName = () => {
			let newUserName = document.getElementById('input-username').value;
			socket.emit('join', newUserName);
		};

	</script>
	<script type="text/javascript" src='/utils/nav.js'></script>

</body>
</html>